# Copy to backend/.env and fill in. backend/.env is ignored by git.

# Anthropic API key (https://console.anthropic.com). Never commit the real value.
ANTHROPIC_API_KEY=

# Model answering the questions, and its effort. claude-haiku-5-5 is faster and cheaper.
ASSISTANT_MODEL=claude-opus-5-5
ASSISTANT_EFFORT=low

# Local PostgreSQL 16 (psycopg v3 driver). A hosted URL such as Neon's
# postgresql://user:pw@host/neondb?sslmode=require is accepted as is.
DATABASE_URL=postgresql+psycopg://postgres:CHANGE_ME@localhost:5432/boutique_vocale
# Dedicated database for pytest, dropped and recreated by the test fixtures
TEST_DATABASE_URL=postgresql+psycopg://postgres:CHANGE_ME@localhost:5432/boutique_vocale_test

# Generate the fictional shop when the database is empty, and move its dates to today.
SEED_ON_STARTUP=true
SLIDE_DATES_ON_STARTUP=true
SHOP_NAME=Boutique Keur Fatou

# Password asked by the browser for the whole app (empty = no password, local only).
# Always set it on a public deployment.
APP_USERNAME=boutique
APP_PASSWORD=

LOG_LEVEL=INFO
